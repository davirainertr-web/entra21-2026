DELIMITER $$

create procedure totalJogadores(
out quantidade int )
Begin
	
    select count(*) INTO quantidade
    From tb_jogadores;
    
END $$

Delimiter ;

Call totalJogadores(@total);

select @total;

DELIMITER $$

create procedure verificarGer(
In p_ger INT )
Begin
IF p_ger >= 83 then
select 'ger alto';
else
select 'ger baixo';
end if;
END $$
DELIMITER ;

Call verificarGer(88);


DELIMITER $$

Create procedure contar()
begin
DECLARE i int default 1;
While i <= 5 do 
select i;
set i = i + 1;
END while;
end $$
DELIMITER ;

call contar();

DELIMITER $$

CREATE PROCEDURE adicionarGer(
    IN p_nome VARCHAR(100),
    IN p_ger INT
)
BEGIN

    DECLARE gerAtual INT;

    SELECT ger
    INTO gerAtual
    FROM tb_jogadores
    WHERE nome = p_nome;

    IF gerAtual IS NULL THEN

        INSERT INTO ger(nome, ger)
        VALUES(p_nome, p_ger);

    ELSE

        UPDATE tb_jogadores
        SET ger = ger + p_ger
        WHERE nome = p_nome;

    END IF;

END $$

DELIMITER ;

set sql_safe_updates=0;

call adicionarGer('Andres', 1);
select * from tb_jogadores;

show procedure status;
